# API key required on the /mcp endpoint. Leave empty to disable auth (not recommended for production).
OMNIFORGE_API_KEY=change-me

# Execution time is set per tool with timeout_seconds (default 120 seconds).
# Legacy OMNIFORGE_MAX_SCRIPT_TIMEOUT_MS is no longer used.
OMNIFORGE_MAX_SCRIPT_MEMORY_MB=512

# Output locations available to configured tools. In Docker these are container paths.
# Separate multiple roots with : on Linux; mount each host folder into the container.
OMNIFORGE_ALLOWED_FOLDERS=/opt/omniforge/files
